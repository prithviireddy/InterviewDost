# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg-compatible)
DATABASE_URL=postgresql://user:password@localhost:5432/interviewdost

# ── Groq ───────────────────────────────────────────────────────────────────────
# API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Deepgram (STT / TTS) ───────────────────────────────────────────────────────
# API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── URLs ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
APP_ENV=development     # set to "production" in prod

# ── Razorpay (optional — leave blank to disable payments) ──────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
